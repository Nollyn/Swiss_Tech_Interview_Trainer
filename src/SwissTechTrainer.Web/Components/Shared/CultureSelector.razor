@using System.Globalization
@inject NavigationManager Navigation

<div class="dropdown">
    <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1 py-1 px-2" 
            type="button" 
            id="cultureDropdown" 
            data-bs-toggle="dropdown" 
            aria-expanded="false">
        <span>@CurrentFlag</span>
        <span class="d-none d-sm-inline small">@CurrentLanguageName</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" aria-labelledby="cultureDropdown">
        <li>
            <a class="dropdown-item @(CurrentCulture == "en" ? "active" : "") d-flex align-items-center gap-2" 
               href="@GetCultureChangeUri("en")">
                <span>🇬🇧</span> English
            </a>
        </li>
        <li>
            <a class="dropdown-item @(CurrentCulture == "de" ? "active" : "") d-flex align-items-center gap-2" 
               href="@GetCultureChangeUri("de")">
                <span>🇩🇪</span> Deutsch
            </a>
        </li>
        <li>
            <a class="dropdown-item @(CurrentCulture == "es" ? "active" : "") d-flex align-items-center gap-2" 
               href="@GetCultureChangeUri("es")">
                <span>🇪🇸</span> Español
            </a>
        </li>
    </ul>
</div>

@code {
    private string CurrentCulture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();

    private string CurrentFlag => CurrentCulture switch
    {
        "de" => "🇩🇪",
        "es" => "🇪🇸",
        _ => "🇬🇧"
    };

    private string CurrentLanguageName => CurrentCulture switch
    {
        "de" => "Deutsch",
        "es" => "Español",
        _ => "English"
    };

    private string GetCultureChangeUri(string culture)
    {
        var uri = Uri.EscapeDataString(Navigation.Uri);
        return $"/api/culture/set?culture={culture}&redirectUri={uri}";
    }
}
