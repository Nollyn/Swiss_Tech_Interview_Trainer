@using System.Globalization
@inject NavigationManager Navigation

<div class="dropdown">
    <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1 py-1 px-2" 
            type="button" 
            id="cultureDropdown" 
            @onclick="ToggleDropdown"
            aria-expanded="@_isOpen">
        <span>@CurrentFlag</span>
        <span class="d-none d-sm-inline small">@CurrentLanguageName</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow @(_isOpen ? "show" : "")" aria-labelledby="cultureDropdown">
        <li @key="@("en")">
            <button type="button" 
                    class="dropdown-item @(CurrentCulture == "en" ? "active" : "") d-flex align-items-center gap-2" 
                    @onclick='() => ChangeCulture("en")'>
                <span>🇬🇧</span> English
            </button>
        </li>
        <li @key="@("de")">
            <button type="button" 
                    class="dropdown-item @(CurrentCulture == "de" ? "active" : "") d-flex align-items-center gap-2" 
                    @onclick='() => ChangeCulture("de")'>
                <span>🇩🇪</span> Deutsch
            </button>
        </li>
        <li @key="@("es")">
            <button type="button" 
                    class="dropdown-item @(CurrentCulture == "es" ? "active" : "") d-flex align-items-center gap-2" 
                    @onclick='() => ChangeCulture("es")'>
                <span>🇪🇸</span> Español
            </button>
        </li>
    </ul>
</div>

@code {
    private bool _isOpen;

    private string CurrentCulture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToLowerInvariant();

    private string CurrentFlag => CurrentCulture switch
    {
        "de" => "🇩🇪",
        "es" => "🇪🇸",
        _ => "🇬🇧"
    };

    private string CurrentLanguageName => CurrentCulture switch
    {
        "de" => "Deutsch",
        "es" => "Español",
        _ => "English"
    };

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
    }

    private void ChangeCulture(string culture)
    {
        _isOpen = false;
        var relativeUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var targetUri = string.IsNullOrEmpty(relativeUri) ? "/" : "/" + relativeUri;
        var encodedTarget = Uri.EscapeDataString(targetUri);
        Navigation.NavigateTo($"/api/culture/set?culture={culture}&redirectUri={encodedTarget}", forceLoad: true);
    }
}
