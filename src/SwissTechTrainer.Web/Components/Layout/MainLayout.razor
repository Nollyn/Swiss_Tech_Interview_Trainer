@inherits LayoutComponentBase

<div class="page d-flex flex-column min-vh-100">
    <header class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary px-4 sticky-top">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
            <span class="badge bg-danger text-white px-2 py-1 fs-6 fw-bold">🇨🇭 CH</span>
            <span class="fw-bold tracking-tight">@L["AppTitle"]</span>
            <span class="badge bg-secondary text-light ms-2 fs-7">@L["AppSubtitle"]</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="navbarContent">
            <ul class="navbar-nav align-items-center gap-3">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-grid-fill me-1"></i> @L["NavDashboard"]
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="history">
                        <i class="bi bi-clock-history me-1"></i> @L["NavHistory"]
                    </NavLink>
                </li>
                <li class="nav-item">
                    <CultureSelector />
                </li>
                <li class="nav-item">
                    <span class="badge bg-outline-secondary border text-muted py-2 px-3">
                        <i class="bi bi-person-badge text-info me-1"></i> SwissTechLead_Candidate
                    </span>
                </li>
            </ul>
        </div>
    </header>

    <main class="flex-grow-1 bg-dark text-light p-4">
        <div class="container-xxl">
            @Body
        </div>
    </main>

    <footer class="footer bg-black text-secondary border-top border-secondary py-3 text-center small">
        <div class="container">
            <span class="text-muted">Swiss Tech Interview Trainer &copy; 2026 — Optimized for Zurich Senior / Tech Lead hiring processes (.NET 10 Clean Architecture).</span>
        </div>
    </footer>
</div>
