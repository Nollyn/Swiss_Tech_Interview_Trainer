@page "/"
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Dashboard | Swiss Tech Interview Trainer</PageTitle>

@if (_dashboard == null)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-danger" role="status">
            <span class="visually-hidden">Loading candidate dashboard...</span>
        </div>
    </div>
}
else
{
    <!-- Candidate Profile Banner -->
    <div class="card mb-4 border-secondary p-4 bg-gradient">
        <div class="row align-items-center">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <span class="badge bg-danger fs-6 px-3 py-2">🇨🇭 Swiss Tech Hiring Track</span>
                    <h3 class="mb-0 fw-bold">@_dashboard.Username</h3>
                </div>
                <p class="text-secondary mb-2">
                    Target Role: <strong class="text-light">@_dashboard.TargetRole</strong>
                </p>
                <div class="d-flex align-items-center gap-4 text-secondary small">
                    <span><i class="bi bi-trophy text-warning me-1"></i> Completed: <strong>@_dashboard.TotalCompletedExercises / 35 Levels</strong></span>
                    <span><i class="bi bi-shield-check text-success me-1"></i> Quality Gate: <strong>&ge; 90% Mastery Threshold</strong></span>
                </div>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <div class="d-inline-block text-center p-3 rounded bg-dark border border-secondary">
                    <div class="fs-2 fw-bold text-info">@_dashboard.OverallMasteryPercentage%</div>
                    <div class="small text-secondary text-uppercase tracking-wide">Overall Readiness</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Grid -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap-fill text-danger me-2"></i>Interview Categories</h4>
        <span class="text-secondary small">7 Specialized Swiss Tech Lead Dimensions</span>
    </div>

    <div class="row g-4">
        @foreach (var cat in _dashboard.Categories)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card category-card h-100 p-3 position-relative">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="category-icon-box">
                                    <i class="bi @cat.Icon fs-4"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">@cat.DisplayName</h6>
                                    <span class="badge bg-dark-subtle text-light border small">@cat.CurrentLevelLabel</span>
                                </div>
                            </div>

                            @if (cat.HintModeActive)
                            {
                                <span class="badge bg-warning text-dark" title="Hint Mode Unlocked after 3 failed attempts">
                                    <i class="bi bi-lightbulb-fill"></i> Hint Mode
                                </span>
                            }
                        </div>

                        <p class="text-secondary small mb-3">@cat.ShortDescription</p>
                    </div>

                    <div>
                        <div class="d-flex justify-content-between small text-secondary mb-1">
                            <span>Level Progress</span>
                            <span>@cat.CompletedLevelsCount / 5 Completed (@cat.ProgressPercentage%)</span>
                        </div>
                        <div class="progress mb-3 bg-black" style="height: 8px;">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: @(cat.ProgressPercentage)%;"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary">
                            <div class="small text-muted">
                                @if (cat.HighestScoreAchieved > 0)
                                {
                                    <span>Best: <strong class="text-info">@cat.HighestScoreAchieved%</strong></span>
                                }
                                else
                                {
                                    <span>Not started</span>
                                }
                            </div>
                            <a href="exercise/@cat.Category" class="btn btn-sm btn-outline-danger px-3 fw-semibold">
                                Practice Level @((int)cat.CurrentLevel) <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private UserDashboardDto? _dashboard;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _dashboard = await Mediator.Send(new GetUserDashboardQuery());
    }
}
