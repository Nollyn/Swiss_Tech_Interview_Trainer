@page "/history"
@inject IMediator Mediator

<PageTitle>Attempt History | Swiss Tech Interview Trainer</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a href="/" class="text-secondary text-decoration-none small mb-1 d-inline-block">
            <i class="bi bi-chevron-left"></i> Back to Dashboard
        </a>
        <h3 class="fw-bold mb-0"><i class="bi bi-clock-history text-danger me-2"></i>Candidate Evaluation History</h3>
    </div>
    <span class="badge bg-dark-subtle border text-secondary px-3 py-2">
        <i class="bi bi-person-badge me-1"></i> SwissTechLead_Candidate
    </span>
</div>

@if (IsLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="text-secondary mt-2">Loading attempt records...</p>
    </div>
}
else if (AllHistory == null || AllHistory.Count == 0)
{
    <div class="card p-5 text-center border-secondary">
        <i class="bi bi-journal-x text-secondary fs-1 mb-3"></i>
        <h5>No Submissions Recorded Yet</h5>
        <p class="text-secondary">Start practicing exercises across any of the 7 interview categories to build your evaluation portfolio.</p>
        <div>
            <a href="/" class="btn btn-danger px-4 fw-semibold">Go to Dashboard</a>
        </div>
    </div>
}
else
{
    <div class="card p-3 border-secondary mb-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover border-secondary align-middle">
                <thead>
                    <tr class="text-secondary small">
                        <th>Timestamp</th>
                        <th>Category</th>
                        <th>Exercise Title</th>
                        <th>Level</th>
                        <th>Deterministic Score</th>
                        <th>Quality Gate Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (cat, item) in AllHistory)
                    {
                        <tr>
                            <td class="small text-secondary">@item.SubmittedAt.ToLocalTime().ToString("g")</td>
                            <td>
                                <span class="badge bg-dark text-light border">@cat.GetDisplayName()</span>
                            </td>
                            <td class="fw-semibold">@item.ExerciseTitle</td>
                            <td><span class="badge bg-secondary">@item.Level</span></td>
                            <td>
                                <span class="badge bg-@(item.DeterministicScore >= 90 ? "success" : item.DeterministicScore >= 75 ? "warning text-dark" : "danger") fs-6">
                                    @item.DeterministicScore%
                                </span>
                            </td>
                            <td>
                                @if (item.PassedThreshold)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Level Unlocked (&ge;90%)</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-arrow-repeat me-1"></i> Retry Required</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool IsLoading = true;
    private List<(CategoryType Category, CategoryAttemptHistoryItemDto Item)> AllHistory = new();

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            var combined = new List<(CategoryType Category, CategoryAttemptHistoryItemDto Item)>();
            foreach (var cat in Enum.GetValues<CategoryType>())
            {
                var history = await Mediator.Send(new GetCategoryHistoryQuery(cat));
                foreach (var h in history)
                {
                    combined.Add((cat, h));
                }
            }

            AllHistory = combined.OrderByDescending(x => x.Item.SubmittedAt).ToList();
        }
        finally
        {
            IsLoading = false;
        }
    }
}
