@page "/history"
@inject IMediator Mediator

<PageTitle>@L["AttemptHistoryTitle"] | @L["AppTitle"]</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <a href="/" class="text-secondary text-decoration-none small mb-1 d-inline-block">
            <i class="bi bi-chevron-left"></i> @L["BackToDashboard"]
        </a>
        <h3 class="fw-bold mb-0"><i class="bi bi-clock-history text-danger me-2"></i>@L["AttemptHistoryTitle"]</h3>
    </div>
    
    <div class="d-flex align-items-center gap-2">
        <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="SelectedLanguageFilter" @bind:after="ApplyFilter">
            <option value="">@L["AllLanguages"]</option>
            @foreach (var lang in Enum.GetValues<ProgrammingLanguage>())
            {
                <option value="@lang">@lang.GetDisplayName()</option>
            }
        </select>
        
        <span class="badge bg-dark-subtle border text-secondary px-3 py-2">
            <i class="bi bi-person-badge me-1"></i> SwissTechLead_Candidate
        </span>
    </div>
</div>

@if (IsLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="text-secondary mt-2">Loading attempt records...</p>
    </div>
}
else if (FilteredHistory == null || FilteredHistory.Count == 0)
{
    <div class="card p-5 text-center border-secondary">
        <i class="bi bi-journal-x text-secondary fs-1 mb-3"></i>
        <h5>No Submissions Recorded Yet</h5>
        <p class="text-secondary">Start practicing exercises across any of the 7 interview categories to build your evaluation portfolio.</p>
        <div>
            <a href="/" class="btn btn-danger px-4 fw-semibold">@L["BackToDashboard"]</a>
        </div>
    </div>
}
else
{
    <div class="card p-3 border-secondary mb-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover border-secondary align-middle">
                <thead>
                    <tr class="text-secondary small">
                        <th>@L["Date"]</th>
                        <th>Language</th>
                        <th>Category</th>
                        <th>Exercise Title</th>
                        <th>Level</th>
                        <th>@L["Score"]</th>
                        <th>@L["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (cat, item) in FilteredHistory)
                    {
                        <tr>
                            <td class="small text-secondary">@item.SubmittedAt.ToLocalTime().ToString("g")</td>
                            <td>
                                <span class="badge @item.Language.GetBadgeClass()">@item.Language.GetDisplayName()</span>
                            </td>
                            <td>
                                <span class="badge bg-dark text-light border">@cat.GetDisplayName(item.Language)</span>
                            </td>
                            <td class="fw-semibold">@item.ExerciseTitle</td>
                            <td><span class="badge bg-secondary">@item.Level</span></td>
                            <td>
                                <span class="badge bg-@(item.DeterministicScore >= 90 ? "success" : item.DeterministicScore >= 75 ? "warning text-dark" : "danger") fs-6">
                                    @item.DeterministicScore%
                                </span>
                            </td>
                            <td>
                                @if (item.PassedThreshold)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> @L["Passed"] (&ge;90%)</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-arrow-repeat me-1"></i> @L["Failed"]</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool IsLoading = true;
    private List<(CategoryType Category, CategoryAttemptHistoryItemDto Item)> AllHistory = new();
    private List<(CategoryType Category, CategoryAttemptHistoryItemDto Item)> FilteredHistory = new();
    private string SelectedLanguageFilter { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            var combined = new List<(CategoryType Category, CategoryAttemptHistoryItemDto Item)>();
            foreach (var cat in Enum.GetValues<CategoryType>())
            {
                var history = await Mediator.Send(new GetCategoryHistoryQuery(cat));
                foreach (var h in history)
                {
                    combined.Add((cat, h));
                }
            }

            AllHistory = combined.OrderByDescending(x => x.Item.SubmittedAt).ToList();
            ApplyFilter();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(SelectedLanguageFilter) || !Enum.TryParse<ProgrammingLanguage>(SelectedLanguageFilter, out var lang))
        {
            FilteredHistory = AllHistory;
        }
        else
        {
            FilteredHistory = AllHistory.Where(h => h.Item.Language == lang).ToList();
        }
    }
}
