@using System.Globalization
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="@CurrentCulture" data-bs-theme="@CurrentTheme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="app.css" />
    <title>Swiss Tech Interview Trainer | Zurich Senior & Tech Lead Track</title>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body class="@(CurrentTheme == "dark" ? "bg-dark text-light" : "bg-light text-dark")">
    <Routes @rendermode="InteractiveServer" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="theme.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    private string CurrentCulture => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    private string CurrentTheme
    {
        get
        {
            var cookie = HttpContextAccessor.HttpContext?.Request.Cookies["app_theme"];
            return cookie == "light" ? "light" : "dark";
        }
    }
}
